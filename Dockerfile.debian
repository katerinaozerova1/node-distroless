# Same app + slnodejs as Dockerfile, but single-stage Debian (full OS, includes /bin/sh).
# Use this for local debugging or comparison; CI can build either image.

FROM node:20-bookworm-slim
WORKDIR /srv

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY app.js ./

ENV NODE_OPTIONS="-r /srv/node_modules/slnodejs/lib/preload.js"
ENV SL_labId="cs5227-repro-dev"
ENV HTTP_PROXY="http://aws-proxy-dev.cloud.capitalone.com:8099"
ENV PORT=3000
EXPOSE 3000

CMD ["node", "/srv/app.js"]
