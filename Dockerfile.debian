# Debian-based image includes /bin/sh — execSync preload works (contrast with distroless)
FROM node:20-bookworm-slim

WORKDIR /app

COPY package.json app.js fake-sl-cli.js sltoken.txt buildSessionId ./
COPY preload-sealights-execsync.js preload-active.js

ENV NODE_OPTIONS="-r /app/preload-active.js"
ENV PORT=3000
EXPOSE 3000

CMD ["node", "/app/app.js"]
