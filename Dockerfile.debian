# Same Capital One–style onboarding as Dockerfile, but final image is Debian-based (includes /bin/sh).
# Useful contrast when debugging distroless-only failures.

FROM node:20-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# app.js is at the repository root; here it becomes /app/app.js
COPY app.js ./

ENV NODE_OPTIONS="-r /app/node_modules/slnodejs/lib/preload.js"
ENV SL_labId="cs5227-repro-dev"
ENV HTTP_PROXY="http://aws-proxy-dev.cloud.capitalone.com:8099"
ENV PORT=3000
EXPOSE 3000

# Official node:20-bookworm-slim uses Node at /usr/local/bin/node. Absolute /app/app.js avoids slnodejs argv bugs.
CMD ["/usr/local/bin/node", "/app/app.js"]
